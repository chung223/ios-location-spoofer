#!name=iOS Location Spoofer
#!desc=透过 MITM 改写 Apple 定位回应的经纬度。Quantumult X 适用。
#!homepage=https://github.com/mekos2772/ios-location-spoofer

[rewrite_local]
^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/mekos2772/ios-location-spoofer/main/location-spoofer-qx.js

[filter_local]
# 離線 tile 快取端點：iOS 會向它拉取整片區域的真實 BSSID→GPS 對照表並快取在本機，
# 之後不請求 gs-loc 就能離線算出真實位置，等於繞過上面的改寫腳本（行動網路下最常見的失敗原因）。
# 攔掉它，逼 iOS 退回我們有攔改的即時 gs-loc 查詢。
# 用連線層 REJECT 而非 URL Rewrite：不需要對該網域解密，少一個會壞的環節。
host, gspe85-ssl.ls.apple.com, reject
host, gspe85-cn-ssl.ls.apple.com, reject

[mitm]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
